# Copy these names into Streamlit Community Cloud > App settings > Secrets.
# Never commit the real App Password.
REPORT_SMTP_USERNAME = "your-sender@gmail.com"
REPORT_SMTP_APP_PASSWORD = "your-google-app-password"

# Ticksy uses Gemini Flash by default. Copy the selected provider key only.
GEMINI_API_KEY = "your-gemini-api-key"
# OPENAI_API_KEY = "your-openai-api-key"

[assistant]
provider = "gemini"
gemini_model = "gemini-3.7-flash"
openai_model = "gpt-5.6-terra"

# Leave local until the cloud snapshot is uploaded and verified.
[storage]
provider = "local" # Change to "r2" after verification.
endpoint_url = "https://d80f3b86efd406047f4213ef17146438.r2.cloudflarestorage.com"
region = "auto"
bucket = "stock-analyser-data"
prefix = "" # Store directly under markets/IN and markets/US.
access_key_id = "your-read-only-access-key-id"
secret_access_key = "your-read-only-secret-access-key"
# Optional: pin an existing snapshot ID for reproducible reads or rollback.
# [storage.snapshot_ids]
# IN = "64-character-snapshot-hash"
# US = "64-character-snapshot-hash"

# Local maintenance only. Do not add this section to the deployed app.
[storage_publisher]
endpoint_url = "https://d80f3b86efd406047f4213ef17146438.r2.cloudflarestorage.com"
region = "auto"
bucket = "stock-analyser-data"
prefix = "" # Store directly under markets/IN and markets/US.
access_key_id = "your-maintenance-access-key-id"
secret_access_key = "your-maintenance-secret-access-key"
