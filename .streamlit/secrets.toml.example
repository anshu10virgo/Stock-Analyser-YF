# Copy these names into Streamlit Community Cloud > App settings > Secrets.
# Never commit the real App Password.
REPORT_SMTP_USERNAME = "your-sender@gmail.com"
REPORT_SMTP_APP_PASSWORD = "your-google-app-password"

# Ticksy uses Gemini Flash by default. Copy the selected provider key only.
GEMINI_API_KEY = "your-gemini-api-key"
# OPENAI_API_KEY = "your-openai-api-key"

[assistant]
provider = "gemini"
gemini_model = "gemini-3.7-flash"
openai_model = "gpt-5.6-terra"
